# Normalise text to LF in the repo and working tree.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Patches must stay byte-exact.
*.patch -text
*.diff  -text

# Binary files: never touch.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.icns  binary
*.bmp   binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary
*.gz    binary
*.xz    binary
*.7z    binary
*.exe   binary
*.dll   binary
*.dmg   binary
*.mp3   binary
*.mp4   binary
*.wav   binary
*.pdf   binary

# Keep generated lockfiles out of diffs' noise.
package-lock.json linguist-generated=true -diff
