<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened Runtime 例外（公證必須開 Hardened Runtime）。
  - allow-jit / allow-unsigned-executable-memory：Electron（V8）需要
  - disable-library-validation：yt-dlp_macos 是 PyInstaller 打包的，執行時會把
    Python 的 dylib 解壓到暫存目錄再載入，那些 dylib 不是我們簽的，不關掉會被擋
  沒有任何網路伺服器、相機、麥克風等額外權限。
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
